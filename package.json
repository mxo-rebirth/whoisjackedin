{
  "name": "whoisjackedin",
  "license": "MIT",
  "version": "0.2.0",
  "private": true,
  "description": "Unofficial stats page for the community-run Matrix Online servers",
  "type": "module",
  "scripts": {
    "start": "node build.mjs && node server.js",
    "build": "node build.mjs",
    "test": "node --test test/",
    "seed": "node scripts/seed.mjs",
    "visitors": "node scripts/visitors.mjs",
    "cast-link": "node scripts/cast-link.mjs",
    "lint": "eslint .",
    "dupes": "jscpd api lib src scripts test server.js build.mjs",
    "archive-check": "node scripts/archive-check.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3"
  },
  "jscpd": {
    "format": [
      "javascript"
    ],
    "minTokens": 35,
    "minLines": 3,
    "threshold": 0,
    "reporters": [
      "console"
    ],
    "absolute": false
  }
}
